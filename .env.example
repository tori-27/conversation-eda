# HTTP port of the conversations service
PORT=3000

# Postgres
DATABASE_URL=postgres://app:app@localhost:5432/conversations

# Kafka (comma-separated list of brokers)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=conversations.events

# Fault injection knobs (numbers, default 0)
# Artificial delay to widen race windows, in ms
RACE_DELAY_MS=0
# Probability [0..1] of injected failures
FAIL_RATE=0
# Random extra delay before publishing, in ms
PUBLISH_JITTER_MS=0
